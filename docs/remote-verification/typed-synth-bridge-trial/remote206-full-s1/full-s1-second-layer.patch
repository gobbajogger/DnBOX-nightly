+++ b/tests/product-remote/full-s1.test.mjs
@@ -0,0 +1,94 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {Dnr3Client} from "../../web/product-site/remote/dnr3-client.mjs";
+import {CAP,KEEP,NOTIFY_KIND,STATUS,OP,encodeRequest,decodeRequest} from '../../web/product-site/remote/dnr3.mjs';
+import {createSynthSession,synthAddress} from '../../web/product-site/remote/dnr3-typed-synth.mjs';
+function device({typed=true,bank=2,slot=0,confirm=true}={}){
+ let preset=0,settled=1,valid=true;
+ const writes=[],gets=[],desc=[];
+ const map=new Map();
+ const add=(id,flags=96,value=5,max=100)=>{
+  const key=synthAddress(bank,slot,id,typed);
+  map.set(JSON.stringify(key),{key,unit:flags,value,max,name:'id'+id});
+ };
+ const client={
+  has(c){return [CAP.PARAM,CAP.WATCH,CAP.BASS_BANK_GUARD,...typed?[CAP.TYPED_SYNTH]:[]].includes(c);},
+  async paramGet(a){
+   gets.push(a);
+   return a.map(x=>{
+    let y=map.get(JSON.stringify(x));
+    if(x.kind===41)return {...x,value:bank,max:3};
+    if(x.kind===42)return {...x,value:preset,max:127};
+    if(x.kind===43)return {...x,value:settled,max:1};
+    return {...x,max:y?.max??0,value:y?.value??KEEP};
+   });
+  },
+  async describe(key){
+   desc.push(key);
+   const y=map.get(JSON.stringify(key));
+   if(!y)throw Object.assign(Error('UNSUPPORTED'),{status:STATUS.UNSUPPORTED});
+   return {name:y.name,max:y.max,def:y.def??0,unit:y.unit,names:y.names??[]};
+  },
+  async paramSet(key,value,expect,guard){
+   const y=map.get(JSON.stringify(key));
+   assert.equal(guard.bank,bank);
+   assert.equal(expect,y.value);
+   writes.push({key,value,expect,guard});
+   if(confirm)y.value=value;
+   return {fields:{...key,value}};
+  }
+ };
+ return {add,client,gets,desc,writes,session:createSynthSession(client,slot,()=>valid),
+   reopen(){preset++;},
+   unset(){settled=0;},
+   disconnect(){valid=false;},
+   set(id,field,value){map.get(JSON.stringify(synthAddress(bank,slot,id,typed)))[field]=value;}};
+}
+import {describeOriginalSynth,groupSynthRows} from '../../web/product-site/remote/dnr3-synth-catalog.mjs';
+test('145 source-backed disjoint identities, high bank bits and no collapsed sequencer fields',async()=>{
+ const f=device();
+ const ids=Array.from({length:150},(_,i)=>i).filter(i=>![18,31,33,140,145].includes(i));
+ for(const id of ids)f.add(id);
+ const {rows}=await f.session.read();
+ assert.deepEqual(rows.map(r=>r.id),ids);
+ assert.equal(new Set(rows.map(r=>r.label)).size,145);
+ const g=groupSynthRows(rows);
+ assert.equal(g.length,20);
+ assert.equal(g.flatMap(g=>g.rows).length,145);
+ assert.deepEqual(g.slice(-3).map(g=>[g.key,g.rows.map(r=>r.id)]),[['seq-pitch',ids.slice(ids.indexOf(67),ids.indexOf(83))],['seq-octave',ids.slice(ids.indexOf(83),ids.indexOf(99))],['seq-on',ids.slice(ids.indexOf(99),ids.indexOf(115))]]);
+ const high=rows.find(r=>r.id===149);
+ assert.deepEqual(high.address,{kind:113,a:2,b:0,c:21});
+ assert.equal(describeOriginalSynth(2,22,127).originalUnit,'Seconds');
+ assert.equal(rows.find(r=>r.id===22).value,5); // Raw wire not seconds.
+ assert.equal(describeOriginalSynth(2,136,127).originalUnit,null); // Known upstream metadata gap.
+});
+test('only discovered rows, read-only high control, stable LINK extension and future unknowns',async()=>{
+ const f=device();
+ f.add(16);f.add(149,64);f.add(34,32);
+ f.add(202);f.add(255,96,0,1);
+ const {rows}=await f.session.read();
+ assert.deepEqual(rows.map(r=>[r.id,r.writable,r.label]),[[16,true,'Cutoff'],[34,false,'Bitcrush Rate'],[202,true,'id202 · ID 202'],[255,true,'Filter Link']]);
+ assert.deepEqual(rows.at(-1).choices,['Off','On']);
+ assert.deepEqual(rows.at(-1).address,{kind:113,a:2,b:0,c:127});
+ assert.equal(describeOriginalSynth(2,255,127),undefined);
+ assert.equal(groupSynthRows(rows).at(-1).title,'Other firmware controls');
+ await assert.rejects(f.session.write(34,3));
+ assert.equal(f.writes.length,0);
+ await f.session.write(255,1);
+ assert.deepEqual(f.writes.map(w=>[w.key.kind,w.key.c,w.value]),[[113,127,1]]);
+ f.add(255,96,0,127); assert.ok(!(await f.session.read()).rows.some(r=>r.id===255));
+});
+test('partial, duplicate or unstable descriptor choices do not change wire values or authorize stale write',async()=>{
+ const f=device();
+ f.add(115,96,1,2);
+ f.set(115,'names',['LP','BP']); // Partial list cannot label the full range.
+ const read=()=>f.session.read().then(s=>s.rows[0]);
+ assert.equal((await read()).choices,undefined);
+ f.set(115,'names',['LP','LP','HP']);
+ assert.equal((await read()).choices,undefined);
+ f.set(115,'names',['LP','BP','HP']);
+ assert.deepEqual((await read()).choices,['LP','BP','HP']);
+ f.set(115,'names',['LP','HP','BP']);
+ await assert.rejects(f.session.write(115,2),/descriptor changed/);
+ assert.equal(f.writes.length,0);
+});
