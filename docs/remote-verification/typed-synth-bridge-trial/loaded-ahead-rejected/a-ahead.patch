+/* Owner-local synthesis only. Shared bus shaping and additive mixes retain
+ * their original stage order. Do not call early for routed (core 1) owners. */
+static int bass_render_dsp(int b,unsigned n)
+{
+    float *bl=eng_bass_buf[2*b], *br=eng_bass_buf[2*b+1];
+    (void)original_runtime_prepare(&original_bass[b], seq_tempo(&seq));
+    bass_adapt_pre(b,n);
+    int status=original_runtime_render(&original_bass[b],b?&original_workspace_b:&original_workspace,bl,br,n);
+    bass_adapt_post(b,bl,br,n);
+    return status==ORIGINAL_RUNTIME_OK;
+}
